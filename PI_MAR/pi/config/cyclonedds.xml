<?xml version="1.0" encoding="UTF-8"?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">
    <!-- RMW configures the loopback interface via ROS_LOCALHOST_ONLY=1. -->
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers><Peer Address="127.0.0.1"/></Peers>
    </Discovery>
    <Internal>
      <!-- A raw RGB frame is close to 1 MiB. Request headroom within the host limit. -->
      <SocketReceiveBufferSize max="4MB"/>
    </Internal>
  </Domain>
</CycloneDDS>
