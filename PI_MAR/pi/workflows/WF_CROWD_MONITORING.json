{
  "code": "WF_CROWD_MONITORING",
  "version": 4,
  "name": "Đo mật độ tại checkpoint theo số vòng hữu hạn",
  "deployment_note": "Bản 4: 11 STEP TYPE; không CALL_WORKFLOW; đối chiếu capability trước khi chạy.",
  "required_capabilities": [
    "nav2",
    "ai_crowd",
    "notification"
  ],
  "tasks": [
    {
      "code": "MAIN",
      "name": "Luồng chính",
      "display_order": 0
    }
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "map_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "checkpoint_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "zone_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "warning_count": {
        "type": "integer",
        "minimum": 0
      },
      "max_loops": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "required": [
      "map_id",
      "checkpoint_id",
      "zone_id",
      "warning_count",
      "max_loops"
    ],
    "additionalProperties": false
  },
  "start": "INIT",
  "max_duration_sec": 1200,
  "max_step_visits": 100,
  "output_mapping": {
    "zone_id": {
      "$ref": "/input/zone_id"
    },
    "samples_taken": {
      "$ref": "/vars/loops"
    },
    "last_metrics": {
      "$ref": "/outputs/SENSE/metrics"
    },
    "captured_at": {
      "$ref": "/outputs/SENSE/captured_at"
    }
  },
  "steps": [
    {
      "code": "INIT",
      "task_code": "MAIN",
      "type": "SET_CONTEXT",
      "params": {
        "assignments": {
          "loops": 0
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "MOVE"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "MOVE",
      "task_code": "MAIN",
      "type": "MOVE",
      "params": {
        "map_id": {
          "$ref": "/input/map_id"
        },
        "endpoint_id": {
          "$ref": "/input/checkpoint_id"
        },
        "mode": "PATROL",
        "max_speed_mps": {
          "$ref": "/system/max_speed_mps"
        }
      },
      "timeout_sec": 180,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "SENSE"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "next": "HELP"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "next": "HELP"
        }
      ]
    },
    {
      "code": "SENSE",
      "task_code": "MAIN",
      "type": "EXECUTE_SENSING",
      "params": {
        "task_type": "CROWD_DENSITY",
        "zone_id": {
          "$ref": "/input/zone_id"
        },
        "window_sec": 5
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "CHECK"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "next": "HELP"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "next": "HELP"
        }
      ]
    },
    {
      "code": "CHECK",
      "task_code": "MAIN",
      "type": "CHECK_CONDITION",
      "params": {
        "expression": {
          "op": "ge",
          "args": [
            {
              "var": "/outputs/SENSE/metrics/count"
            },
            {
              "var": "/input/warning_count"
            }
          ]
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 1,
          "next": "WARN",
          "when": {
            "var": "/result/value"
          }
        },
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "INCREMENT"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "WARN",
      "task_code": "MAIN",
      "type": "NOTIFY",
      "params": {
        "notification_type": "CROWD_WARNING",
        "severity": "WARNING",
        "recipients": [
          "STAFF"
        ],
        "data": {
          "metrics": {
            "$ref": "/outputs/SENSE/metrics"
          },
          "zone_id": {
            "$ref": "/input/zone_id"
          },
          "checkpoint_id": {
            "$ref": "/input/checkpoint_id"
          },
          "captured_at": {
            "$ref": "/outputs/SENSE/captured_at"
          },
          "evidence_ref": {
            "$ref": "/outputs/SENSE/evidence_ref"
          }
        },
        "require_ack": false
      },
      "timeout_sec": 60,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "INCREMENT"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "INCREMENT",
      "task_code": "MAIN",
      "type": "SET_CONTEXT",
      "params": {
        "assignments": {
          "loops": {
            "op": "add",
            "args": [
              {
                "var": "/vars/loops"
              },
              1
            ]
          }
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "LOOP"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "LOOP",
      "task_code": "MAIN",
      "type": "CHECK_CONDITION",
      "params": {
        "expression": {
          "op": "lt",
          "args": [
            {
              "var": "/vars/loops"
            },
            {
              "var": "/input/max_loops"
            }
          ]
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 1,
          "next": "WAIT",
          "when": {
            "var": "/result/value"
          }
        },
        {
          "on": "SUCCESS",
          "priority": 100,
          "terminal": "SUCCEEDED"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "WAIT",
      "task_code": "MAIN",
      "type": "WAIT",
      "params": {
        "wait_type": "DURATION",
        "duration_sec": 5
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "SENSE"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "HELP",
      "task_code": "MAIN",
      "type": "NOTIFY",
      "params": {
        "notification_type": "MONITORING_UNAVAILABLE",
        "severity": "WARNING",
        "recipients": [
          "STAFF"
        ],
        "data": {
          "zone_id": {
            "$ref": "/input/zone_id"
          },
          "checkpoint_id": {
            "$ref": "/input/checkpoint_id"
          }
        },
        "require_ack": false
      },
      "timeout_sec": 60,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    }
  ]
}
