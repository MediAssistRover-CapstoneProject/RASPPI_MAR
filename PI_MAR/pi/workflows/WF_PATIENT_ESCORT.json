{
  "code": "WF_PATIENT_ESCORT",
  "version": 4,
  "name": "Dẫn bệnh nhân có xác nhận đích",
  "deployment_note": "Bản 4: 11 STEP TYPE; không CALL_WORKFLOW; đối chiếu capability trước khi chạy.",
  "required_capabilities": [
    "nav2",
    "interaction",
    "notification"
  ],
  "tasks": [
    {
      "code": "MAIN",
      "name": "Luồng chính",
      "display_order": 0
    }
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "map_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "destination_endpoint_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    },
    "required": [
      "map_id",
      "destination_endpoint_id"
    ],
    "additionalProperties": false
  },
  "start": "CONFIRM",
  "max_duration_sec": 1200,
  "max_step_visits": 100,
  "output_mapping": {
    "endpoint_id": {
      "$ref": "/outputs/MOVE/endpoint_id"
    },
    "reached": {
      "$ref": "/outputs/MOVE/reached"
    }
  },
  "steps": [
    {
      "code": "CONFIRM",
      "task_code": "MAIN",
      "type": "INTERACT",
      "params": {
        "action": "CONFIRM",
        "language": "vi-VN",
        "prompt_key": "CONFIRM_DESTINATION",
        "data": {
          "endpoint_id": {
            "$ref": "/input/destination_endpoint_id"
          }
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "DECIDE"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "DECIDE",
      "task_code": "MAIN",
      "type": "CHECK_CONDITION",
      "params": {
        "expression": {
          "var": "/outputs/CONFIRM/confirmed"
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 1,
          "next": "MOVE",
          "when": {
            "op": "eq",
            "args": [
              {
                "var": "/result/value"
              },
              true
            ]
          }
        },
        {
          "on": "SUCCESS",
          "priority": 100,
          "terminal": "CANCELLED"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "MOVE",
      "task_code": "MAIN",
      "type": "MOVE",
      "params": {
        "map_id": {
          "$ref": "/input/map_id"
        },
        "endpoint_id": {
          "$ref": "/input/destination_endpoint_id"
        },
        "mode": "ESCORT",
        "max_speed_mps": {
          "$ref": "/system/max_speed_mps"
        }
      },
      "timeout_sec": 180,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "next": "ARRIVED"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "next": "HELP"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "next": "HELP"
        }
      ]
    },
    {
      "code": "ARRIVED",
      "task_code": "MAIN",
      "type": "INTERACT",
      "params": {
        "action": "SPEAK",
        "language": "vi-VN",
        "prompt_key": "ARRIVED_DESTINATION",
        "data": {
          "endpoint_id": {
            "$ref": "/outputs/MOVE/endpoint_id"
          }
        }
      },
      "timeout_sec": 30,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "terminal": "SUCCEEDED"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    },
    {
      "code": "HELP",
      "task_code": "MAIN",
      "type": "NOTIFY",
      "params": {
        "notification_type": "NAVIGATION_FAILED",
        "severity": "WARNING",
        "recipients": [
          "STAFF"
        ],
        "data": {
          "endpoint_id": {
            "$ref": "/input/destination_endpoint_id"
          }
        },
        "require_ack": false
      },
      "timeout_sec": 60,
      "max_attempts": 1,
      "retry_delay_sec": 0,
      "retry_codes": [],
      "transitions": [
        {
          "on": "SUCCESS",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "FAILURE",
          "priority": 100,
          "terminal": "FAILED"
        },
        {
          "on": "TIMEOUT",
          "priority": 100,
          "terminal": "FAILED"
        }
      ]
    }
  ]
}
