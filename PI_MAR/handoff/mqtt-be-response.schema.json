{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediassistrover.invalid/contracts/phase0/mqtt-be-response.schema.json",
  "title": "HELLO_ACK EVENT_ACK SERVER_HEARTBEAT",
  "$comment": "MAR-STEP-2 with MQTT navigation profile synchronization.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "messageType": {
          "const": "HELLO_ACK"
        },
        "robotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "transportSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "contract": {
          "const": "MAR-STEP-2"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "messageType",
        "robotId",
        "transportSessionId",
        "contract",
        "accepted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "messageType": {
          "const": "EVENT_ACK"
        },
        "robotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "transportSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "messageId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "accepted": {
          "type": "boolean"
        }
      },
      "required": [
        "messageType",
        "robotId",
        "transportSessionId",
        "messageId",
        "accepted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "messageType": {
          "const": "SERVER_HEARTBEAT"
        },
        "robotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "transportSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "messageType",
        "robotId",
        "transportSessionId"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "messageType": {
          "const": "NAV_PROFILE"
        },
        "robotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transportSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileVersion": {
          "const": "BE-NAV-PROFILE-1"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "object",
          "properties": {
            "map_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "map_asset_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "frame_id": {
              "type": "string",
              "minLength": 1
            },
            "map_version": {
              "type": "integer",
              "minimum": 1
            },
            "endpoints": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "map_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "x_m": {
                    "type": "number"
                  },
                  "y_m": {
                    "type": "number"
                  },
                  "yaw_rad": {
                    "type": "number"
                  }
                },
                "required": [
                  "map_id",
                  "x_m",
                  "y_m",
                  "yaw_rad"
                ],
                "additionalProperties": false
              }
            },
            "navigation_session_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "initialization_revision": {
              "type": "integer",
              "minimum": 0
            },
            "zones": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "type": "object",
                "properties": {
                  "zone_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "zone_type": {
                    "enum": [
                      "SPEED",
                      "KEEP_OUT"
                    ]
                  },
                  "polygon": {
                    "oneOf": [
                      {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 256,
                        "items": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "points": {
                            "type": "array",
                            "minItems": 3,
                            "maxItems": 256,
                            "items": {
                              "type": "array",
                              "minItems": 2,
                              "maxItems": 2,
                              "items": {
                                "type": "number"
                              }
                            }
                          }
                        },
                        "required": [
                          "points"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "speed_limit_mps": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 0.8
                  }
                },
                "required": [
                  "zone_id",
                  "zone_type",
                  "polygon"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "zone_type": {
                          "const": "SPEED"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "speed_limit_mps"
                      ]
                    }
                  }
                ]
              }
            }
          },
          "required": [
            "map_id",
            "map_asset_sha256",
            "frame_id",
            "map_version",
            "endpoints"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "messageType",
        "robotId",
        "transportSessionId",
        "profileVersion",
        "profileHash",
        "profile"
      ],
      "additionalProperties": false
    }
  ]
}
