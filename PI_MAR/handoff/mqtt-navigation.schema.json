{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "messageType": {
          "const": "NAV_PROFILE"
        },
        "robotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transportSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileVersion": {
          "const": "BE-NAV-PROFILE-1"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile": {
          "type": "object",
          "properties": {
            "map_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "map_asset_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "frame_id": {
              "type": "string",
              "minLength": 1
            },
            "map_version": {
              "type": "integer",
              "minimum": 1
            },
            "endpoints": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "map_id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "x_m": {
                    "type": "number"
                  },
                  "y_m": {
                    "type": "number"
                  },
                  "yaw_rad": {
                    "type": "number"
                  }
                },
                "required": [
                  "map_id",
                  "x_m",
                  "y_m",
                  "yaw_rad"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "map_id",
            "map_asset_sha256",
            "frame_id",
            "map_version",
            "endpoints"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "messageType",
        "robotId",
        "transportSessionId",
        "profileVersion",
        "profileHash",
        "profile"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "messageType": {
          "const": "NAV_PROFILE_ACK"
        },
        "robotId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "transportSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "producerSessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "profileHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted": {
          "type": "boolean"
        },
        "mapId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "mapAssetHash": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorCode": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "messageType",
        "robotId",
        "transportSessionId",
        "producerSessionId",
        "profileHash",
        "accepted",
        "mapId",
        "mapAssetHash",
        "errorCode"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "mapId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "mapAssetHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "errorCode": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  ]
}
